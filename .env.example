DATABASE_URL=postgresql://user:password@host/database
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
PORT=3000

# Cloudflare R2: persistent video storage for Shorts

# LiveKit Cloud or self-hosted LiveKit: realtime livestream media
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cloudinary unsigned video upload configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=vibe_shorts
